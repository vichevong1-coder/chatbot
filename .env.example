# Tunsay — environment template (plan.md P0.4).
#
#   cp .env.example .env
#
# Copy this file to .env and fill in the real values. NEVER commit .env —
# .gitignore must cover it. Every value below is a safe placeholder; none of
# them is a real credential.
#
# Hostnames here are docker compose SERVICE NAMES, not localhost. Containers
# reach each other over the internal `tunsay` network, where `postgres`,
# `redis`, `gateway`, `auth_service`, ... all resolve. Only ports 3000 and
# 9000 are published to the host (architecture.md §4).


# ---------------------------------------------------------------------------
# LLM
# ---------------------------------------------------------------------------
# Used by pedagogy_service ONLY — it is the single place that talks to Gemini
# (architecture.md §1, rule 4). Do not add this key to any other service.
# With it unset, pedagogy_service must still return the bilingual fallback
# rather than erroring (plan.md P1.8).
GEMINI_API_KEY=replace-with-your-gemini-api-key

# Select LLM provider: gemini | ollama
LLM_PROVIDER=gemini
# Use http://localhost:11434 when running services locally on host loopback,
# or http://host.docker.internal:11434 if running services inside Docker compose.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b



# ---------------------------------------------------------------------------
# Auth / JWT  (auth_service issues, gateway verifies)
# ---------------------------------------------------------------------------
# Generate a real one with:  openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60


# ---------------------------------------------------------------------------
# Postgres — system of record for auth, content, student_profile, orchestrator
# ---------------------------------------------------------------------------
POSTGRES_USER=tunsay
POSTGRES_PASSWORD=tunsay_dev_password
POSTGRES_DB=tunsay
# Service name, not localhost — this is how containers reach the database.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Must stay consistent with the five values above.
DATABASE_URL=postgresql://tunsay:tunsay_dev_password@postgres:5432/tunsay


# ---------------------------------------------------------------------------
# Redis — orchestrator session store + explanation cache, gateway rate limits
# ---------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0


# ---------------------------------------------------------------------------
# Qdrant — curriculum embeddings for retrieval_service
# ---------------------------------------------------------------------------
QDRANT_URL=http://qdrant:6333


# ---------------------------------------------------------------------------
# MinIO — uploaded homework images (ocr_service) and audio (stt_service)
# ---------------------------------------------------------------------------
# Host:port with no scheme; the S3 API port, not the 9001 console.
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=tunsay_minio_admin
MINIO_SECRET_KEY=tunsay_minio_dev_password


# ---------------------------------------------------------------------------
# Public surface
# ---------------------------------------------------------------------------
# The ONLY origin the gateway's CORS middleware allows (plan.md P1.9).
# This one is a browser-facing URL, so localhost is correct here.
FRONTEND_ORIGIN=http://localhost:3000

# How the frontend's server.ts proxy reaches the backend from inside compose.
GATEWAY_URL=http://gateway:9000


# ---------------------------------------------------------------------------
# Internal service URLs — one per service, ports per architecture.md §4.
# Used by the orchestrator's service_clients/. Service names, never localhost:
# none of these ports is published to the host.
# ---------------------------------------------------------------------------
ORCHESTRATOR_URL=http://orchestrator:9001
AUTH_SERVICE_URL=http://auth_service:9002
CONTENT_SERVICE_URL=http://content_service:9003
SOLVER_SERVICE_URL=http://solver_service:9004
GRADING_SERVICE_URL=http://grading_service:9005
PEDAGOGY_SERVICE_URL=http://pedagogy_service:9006
RETRIEVAL_SERVICE_URL=http://retrieval_service:9007
STUDENT_PROFILE_SERVICE_URL=http://student_profile_service:9008
STT_SERVICE_URL=http://stt_service:9009
OCR_SERVICE_URL=http://ocr_service:9010
SAFETY_SERVICE_URL=http://safety_service:9011
