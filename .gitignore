# Tunsay — ignored files.
# Secrets, build output and local tooling state. `.env.example` is tracked on purpose:
# it is the documented list of required variables, with no real values in it.

# Secrets
.env
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/

# Node / frontend
node_modules/
dist/
build/

# Editors & OS
.vscode/
.idea/
.DS_Store

# Logs
*.log

# Large model binaries & local weights
whisper-small-km-ct2/
